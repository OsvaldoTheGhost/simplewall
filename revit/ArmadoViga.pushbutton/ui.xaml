<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Armado de viga" Width="1180" Height="840" MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="#202023" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CtlBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="CtlBorder" Color="#555558"/>
    <SolidColorBrush x:Key="Accent" Color="#3DA5F5"/>

    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="BorderBrush" Value="#555558"/>
      <Setter Property="CaretBrush" Value="#E6E6E6"/>
      <Setter Property="SelectionBrush" Value="#3DA5F5"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Botones -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Background" Value="#3A3A3D"/>
      <Setter Property="BorderBrush" Value="#555558"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#3DA5F5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2A5C8A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Background" Value="#3A3A3D"/>
      <Setter Property="BorderBrush" Value="#555558"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#3DA5F5"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#24527D"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#3DA5F5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SpinBtn" TargetType="RepeatButton">
      <Setter Property="Foreground" Value="#CFCFCF"/>
      <Setter Property="Background" Value="#3A3A3D"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#555558" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#3DA5F5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2A5C8A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="OkBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#3A7BD5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#4C8FE8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2C63B0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox oscuro -->
    <ControlTemplate x:Key="CbToggle" TargetType="ToggleButton">
      <Border x:Name="bd" Background="#1E1E1E" BorderBrush="#555558" BorderThickness="1" CornerRadius="2">
        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
              Data="M0,0 L4,4 L8,0" Stroke="#CFCFCF" StrokeThickness="1.4"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="bd" Property="BorderBrush" Value="#3DA5F5"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Template="{StaticResource CbToggle}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="6,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Border Background="#2B2B2D" BorderBrush="#555558" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="Transparent" Padding="7,3">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#24527D"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1C3F60"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    
    <SolidColorBrush x:Key="PageBg" Color="#27272A"/>

    <Style x:Key="Grp" TargetType="GroupBox">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Margin" Value="4,0,4,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Grid>
              <Border Margin="0,8,0,0" BorderBrush="#5A5A5E" BorderThickness="1" CornerRadius="3">
                <ContentPresenter Margin="8,14,8,8"/>
              </Border>
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" Padding="4,0"
                      Background="#27272A">
                <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"
                                  TextElement.FontSize="11" TextElement.Foreground="#E6E6E6"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="3" Padding="6,5">
              <Grid>
                <Border x:Name="acc" Width="3" HorizontalAlignment="Left" Background="#3DA5F5"
                        Margin="-6,-5,0,-5" Visibility="Hidden" CornerRadius="3,0,0,3"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#303034"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A3A3F"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#6A6A70"/>
                <Setter TargetName="acc" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BlueBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#3A7BD5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="10,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#4C8FE8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2C63B0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#4A4A4E"/>
                <Setter Property="Foreground" Value="#8A8A8A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GrayBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Background" Value="#48484C"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="8,0"
                    BorderBrush="#5E5E62" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#3DA5F5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2A5C8A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="4,0,10,0"/>
      <Setter Property="Foreground" Value="#A8A8A8"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8C8C8C"/>
      <Setter Property="FontStyle" Value="Italic"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

  </Window.Resources>

  <Border BorderBrush="#3F3F46" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="250"/>
        <RowDefinition Height="50"/>
      </Grid.RowDefinitions>

      <!-- Barra de titulo -->
      <Border x:Name="titleBar" Grid.Row="0" Background="#1B1B1D">
        <Grid>
          <TextBlock Tag="t:title" Text="ARMADO DE VIGA" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontWeight="SemiBold" FontSize="13" IsHitTestVisible="False"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
            <ComboBox x:Name="cbLang" Width="64" Margin="0,0,8,0"/>
            <Button x:Name="btnClose" Style="{StaticResource CloseBtn}" Width="34" Height="28" Content="✕" FontSize="14"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Cuerpo superior -->
      <Grid Grid.Row="1" Margin="8,8,8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#27272A" BorderBrush="#5A5A5E" BorderThickness="1" CornerRadius="3" Padding="8">
          <StackPanel>
            
          <RadioButton x:Name="nav0" GroupName="nav" Style="{StaticResource NavBtn}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="24" Height="20" Margin="0,0,8,0"><Ellipse Canvas.Left="4" Canvas.Top="2" Width="16" Height="16" Stroke="#CFCFCF" StrokeThickness="1.5"/><Ellipse Canvas.Left="9" Canvas.Top="7" Width="6" Height="6" Fill="#3DA5F5"/><Path Stroke="#CFCFCF" StrokeThickness="1.5" Data="M12,0 L12,3 M12,17 L12,20 M2,10 L5,10 M19,10 L22,10"/></Canvas>
              <TextBlock Tag="t:n_cfg" Text="Configuración" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="nav1" GroupName="nav" Style="{StaticResource NavBtn}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="24" Height="20" Margin="0,0,8,0"><Rectangle Canvas.Left="2" Canvas.Top="1" Width="20" Height="18" Stroke="#CFCFCF" StrokeThickness="1.2"/><Path Fill="#3DA5F5" Data="M5,4 h3 v3 h-3 Z M10.5,4 h3 v3 h-3 Z M16,4 h3 v3 h-3 Z M5,13 h3 v3 h-3 Z M10.5,13 h3 v3 h-3 Z M16,13 h3 v3 h-3 Z"/></Canvas>
              <TextBlock Tag="t:n_main" Text="Barras principales" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="nav2" GroupName="nav" Style="{StaticResource NavBtn}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="24" Height="20" Margin="0,0,8,0"><Rectangle Canvas.Left="1" Canvas.Top="3" Width="22" Height="14" Stroke="#CFCFCF" StrokeThickness="1.2"/><Line X1="3" Y1="6.5" X2="21" Y2="6.5" Stroke="#3DA5F5" StrokeThickness="2"/></Canvas>
              <TextBlock Tag="t:n_top" Text="Refuerzo superior" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="nav3" GroupName="nav" Style="{StaticResource NavBtn}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="24" Height="20" Margin="0,0,8,0"><Rectangle Canvas.Left="1" Canvas.Top="3" Width="22" Height="14" Stroke="#CFCFCF" StrokeThickness="1.2"/><Line X1="3" Y1="13.5" X2="21" Y2="13.5" Stroke="#3DA5F5" StrokeThickness="2"/></Canvas>
              <TextBlock Tag="t:n_bot" Text="Refuerzo inferior" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="nav4" GroupName="nav" Style="{StaticResource NavBtn}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="24" Height="20" Margin="0,0,8,0"><Rectangle Canvas.Left="1" Canvas.Top="3" Width="22" Height="14" Stroke="#CFCFCF" StrokeThickness="1.2"/><Path Stroke="#4DD0E1" StrokeThickness="2" Data="M3,10 C8,4 12,16 21,10"/></Canvas>
              <TextBlock Tag="t:n_side" Text="Barra central" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="nav5" GroupName="nav" Style="{StaticResource NavBtn}">
            <StackPanel Orientation="Horizontal">
              <Canvas Width="24" Height="20" Margin="0,0,8,0"><Rectangle Canvas.Left="5" Canvas.Top="1" Width="14" Height="18" RadiusX="2" RadiusY="2" Stroke="#7CC576" StrokeThickness="1.8"/><Line X1="7" Y1="3" X2="12" Y2="8" Stroke="#7CC576" StrokeThickness="1.6"/></Canvas>
              <TextBlock Tag="t:n_stir" Text="Estribos" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#27272A" BorderBrush="#5A5A5E" BorderThickness="1" CornerRadius="3" Padding="4">
          <Grid x:Name="pages">

            <!-- 0: Configuracion -->
            <Grid x:Name="pg0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <GroupBox Grid.Column="0" Style="{StaticResource Grp}" Header="PARÁMETROS DE ARMADO" Tag="t:g_params">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                    <RowDefinition Height="30"/><RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Style="{StaticResource Lbl}" Tag="t:stir_dia" Text="Ø Estribo"/>
                  <ComboBox x:Name="cbStirBt" Grid.Row="0" Grid.Column="1" Width="150" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Tag="t:cover" Text="Recubrimiento"/>
                  <ComboBox x:Name="cbCover" Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="t min"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="tbTmin" Width="52" Text="0.03" VerticalAlignment="Center"/><TextBlock Style="{StaticResource Unit}" Text="m"/></StackPanel>
                  <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Tag="t:partition" Text="Partición"/>
                  <TextBox x:Name="tbPartition" Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left"/>
                  <Border Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0" Background="#1F1F22" BorderBrush="#4A4A4E" BorderThickness="1">
                    <Canvas x:Name="secCanvas0" ClipToBounds="True"/>
                  </Border>
                </Grid>
              </GroupBox>
              <GroupBox Grid.Column="1" Style="{StaticResource Grp}" Header="CREACIÓN DE VISTAS" Tag="t:g_views">
                <StackPanel>
                  <CheckBox x:Name="chkElev" Content="Crear una vista en elevación" Tag="t:mk_elev" Margin="0,2,0,6"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource Lbl}" Tag="t:template" Text="Plantilla" Width="70"/>
                    <ComboBox x:Name="cbElevTpl" Width="260"/>
                  </StackPanel>
                  <CheckBox x:Name="chkCross" Content="Crear cortes transversales (centro de cada tramo)" Tag="t:mk_cross" Margin="0,2,0,6"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource Lbl}" Tag="t:template" Text="Plantilla" Width="70"/>
                    <ComboBox x:Name="cbCrossTpl" Width="260"/>
                  </StackPanel>
                  <CheckBox x:Name="chkReplace" IsChecked="True" Tag="t:replace"
                            Content="Reemplazar el armado creado antes con esta herramienta" Margin="0,2,0,8"/>
                  <Border Height="1" Background="#3F3F46" Margin="0,0,0,6"/>
                  <TextBlock Tag="t:laps_hdr" Text="TRASLAPES" FontWeight="SemiBold" Foreground="#A8A8A8" Margin="0,0,0,4"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Style="{StaticResource Lbl}" Tag="t:lap" Text="Traslape (× db)"/>
                    <TextBox x:Name="tbLap" Width="40" Text="40" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkStock" Tag="t:stock" Content="Long. comercial máx." IsChecked="True" Margin="14,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbStock" Width="44" Text="12" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Unit}" Text="m"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Style="{StaticResource Lbl}" Tag="t:lap_style" Text="Unión"/>
                    <ComboBox x:Name="cbLapStyle" Width="250" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Lbl}" Tag="t:lap_pos_top" Text="Traslapes lecho superior (m desde el inicio, separados por coma)"/>
                  <TextBox x:Name="tbLapPosTop" Margin="0,2,0,5"/>
                  <TextBlock Style="{StaticResource Lbl}" Tag="t:lap_pos_bot" Text="Traslapes lecho inferior (m desde el inicio)"/>
                  <TextBox x:Name="tbLapPosBot" Margin="0,2,0,5"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Lbl}" Tag="t:joint_L" Text="Cambio de sección: anclaje recto"/>
                    <TextBox x:Name="tbJointL" Width="44" Text="1.00" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Unit}" Text="m"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Lbl}" Tag="t:axis_mode" Text="Cambio de eje en apoyos"/>
                    <ComboBox x:Name="cbAxisMode" Width="210" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Border Height="1" Background="#3F3F46" Margin="0,0,0,8"/>
                  <TextBlock x:Name="txtBeamInfo" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                  <TextBlock x:Name="txtSummary" Foreground="#A8A8A8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </GroupBox>
            </Grid>

            <!-- 1: Barras principales -->
            <Grid x:Name="pg1" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <GroupBox Grid.Row="0" Grid.Column="0" Style="{StaticResource Grp}" Header="BARRA PRINCIPAL SUPERIOR" Tag="t:g_top_main">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource Lbl}" Tag="t:top_style" Text="Estilo de barra superior"/>
                    <ComboBox x:Name="cbTopStyle" Width="170"/>
                  </StackPanel>
